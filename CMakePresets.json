{
	"version": 3,
	"cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
	"configurePresets": [
		{
			"name": "vs-base",
			"hidden": true,
			"generator": "Visual Studio 17 2022"
		},
		{
			"name": "vcpkg-base",
			"hidden": true,
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": { "DELTAWORKS_THIRD_PARTY": "PACKAGES" }
		},
		{
			"name": "vs-x64",
			"displayName": "Visual Studio, x64, vcpkg packages",
			"inherits": [ "vs-base", "vcpkg-base" ],
			"architecture": "x64",
			"binaryDir": "${sourceDir}/build/vs-x64",
			"cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static" }
		},
		{
			"name": "vs-win32",
			"displayName": "Visual Studio, Win32, vcpkg packages",
			"inherits": [ "vs-base", "vcpkg-base" ],
			"architecture": "Win32",
			"binaryDir": "${sourceDir}/build/vs-win32",
			"cacheVariables": { "VCPKG_TARGET_TRIPLET": "x86-windows-static" }
		},
		{
			"name": "vs-x64-bundled",
			"displayName": "Visual Studio, x64, bundled third-party copies (no vcpkg)",
			"inherits": [ "vs-base" ],
			"architecture": "x64",
			"binaryDir": "${sourceDir}/build/vs-x64-bundled",
			"cacheVariables": { "DELTAWORKS_THIRD_PARTY": "BUNDLED" }
		},
		{
			"name": "ninja-msvc",
			"displayName": "Ninja + MSVC, x64, vcpkg packages (run from a VS developer prompt)",
			"inherits": [ "vcpkg-base" ],
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/ninja-msvc",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl",
				"VCPKG_TARGET_TRIPLET": "x64-windows-static"
			}
		}
	],
	"buildPresets": [
		{ "name": "vs-x64-debug",   "configurePreset": "vs-x64",   "configuration": "Debug" },
		{ "name": "vs-x64-release", "configurePreset": "vs-x64",   "configuration": "Release" },
		{ "name": "vs-win32-debug",   "configurePreset": "vs-win32", "configuration": "Debug" },
		{ "name": "vs-win32-release", "configurePreset": "vs-win32", "configuration": "Release" },
		{ "name": "vs-x64-bundled-release", "configurePreset": "vs-x64-bundled", "configuration": "Release" }
	]
}
